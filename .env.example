# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Discord bot token (only needed to run dcapp.py)
DC_API_KEY=

# --- Optional: public deployment (defaults shown are used when a line is absent) ---
# Origins of the site that embeds the chat page in an iframe / calls the API (a JSON list)
# CORS_ORIGINS=["https://your-portfolio.pages.dev"]
# Questions allowed per visitor per minute, and in total per day across all visitors (resets 00:00 UTC)
# RATE_LIMIT_PER_MINUTE=8
# DAILY_REQUEST_BUDGET=300
# Number of reverse proxies in front of the app. 0 = ignore X-Forwarded-For (safe default).
# TRUSTED_PROXY_HOPS=0
